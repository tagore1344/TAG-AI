# Tag AI Environment Configuration
# Copy this file to .env and adjust variables as needed

# Host and Port configuration
TAG_AI_HOST=0.0.0.0
TAG_AI_PORT=8000

# Environment and logging (development, testing, production)
TAG_AI_ENV=development
TAG_AI_LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins, empty means restricted by default)
TAG_AI_CORS_ORIGINS=""

# --- AI PROVIDER CREDENTIALS (EMPTY PLACEHOLDERS) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force the Gemini SDK backend - "genai" (modern google-genai SDK,
# default when installed) or "legacy" (google-generativeai, End-of-Life fallback)
TAG_AI_GEMINI_SDK=

# OpenAI: https://platform.openai.com/api-keys
# Optional model override (default gpt-6-astra): TAG_AI_MODEL=
OPENAI_API_KEY=

# DeepSeek: https://platform.deepseek.com  (model: deepseek-chat; OpenAI-compatible
# endpoint at https://api.deepseek.com is used automatically)
DEEPSEEK_API_KEY=

# AI Orchestrator mode: "fallback" (route to best provider, cascade failures) or
# "multi" (query every available provider and build a consolidated consensus).
TAG_AI_CONSENSUS_MODE=fallback
